# ── Vercel 프로젝트 → Settings → Environment Variables 에 그대로 넣는다 ──

# 구글 시트 (Apps Script 웹 앱 URL, Code.gs 의 API_TOKEN 과 같은 값)
GAS_URL=https://script.google.com/macros/s/AKfycb.../exec
GAS_TOKEN=여기를-긴-비밀문자열로-바꾸세요

# 나
OWNER_NAME=홍길동
ADMIN_PIN=1234            # 웹페이지 로그인 + 봇에서 "관리자 1234"
TICK_KEY=아무-긴-문자열     # Apps Script 가 /api/tick 을 부를 때 쓰는 열쇠

# 네이버웍스 (선택 — 관리자 권한이 없으면 전부 비워 둔다. 웹페이지 '대화' 탭이 봇을 대신한다)
WORKS_CLIENT_ID=
WORKS_CLIENT_SECRET=
WORKS_SERVICE_ACCOUNT=xxxx.serviceaccount@도메인
WORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
WORKS_BOT_ID=
WORKS_BOT_SECRET=

# ── 메일 (선택) — 받기와 보내기는 서로 다른 계정이어도 된다 ──
#   메일플러그  imap.mailplug.co.kr:993  /  smtp.mailplug.co.kr:465
#   Gmail      imap.gmail.com:993       /  smtp.gmail.com:465       (앱 비밀번호 필요)
#   네이버      imap.naver.com:993       /  smtp.naver.com:465       (앱 비밀번호 필요)
#
# 받기(IMAP): 받은편지함에서 할 일 후보와 팀원 보고 답장을 읽는다. 비우면 안 읽는다.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# 보내기(SMTP): 아침 브리핑·일일보고 초안·팀원 리마인드를 보낸다. 비우면 메일 알림이 안 간다.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=            # 브리핑을 받을 주소. 비우면 SMTP_USER

# 시각 (한국시간, 24시간). 기본: 브리핑 8시, 팀원 리마인드 9시, 보고 요청 17시, 저녁 초안 18시. 평일만(1~5)
BRIEF_HOUR=8
REMIND_HOUR=9
ASK_HOUR=17
EVENING_HOUR=18
WORKDAYS=1,2,3,4,5

# ── AI 비서 (선택) — 둘 다 넣으면 가벼운 대화·명령은 Gemini, 분석·작성·긴 글은 Claude 로 자동 배분 ──
# ※ Claude Pro/Max·Gemini Advanced 같은 '구독'으로는 쓸 수 없다. API 키를 따로 발급받아야 한다.
GEMINI_API_KEY=            # https://aistudio.google.com → Get API key (Flash 계열 무료 구간 있음)
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=         # https://console.anthropic.com → Billing 충전 후 API Keys (무료 구간 없음)
CLAUDE_MODEL=claude-opus-5
AI_BUDGET_KRW=10000        # 이 달 Claude 사용 추정액이 이 금액을 넘으면 그 달은 Gemini 만 쓴다
USD_KRW=1400

