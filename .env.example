# ── Vercel 프로젝트 → Settings → Environment Variables 에 그대로 넣는다 ──

# 구글 시트 (Apps Script 웹 앱 URL, Code.gs 의 API_TOKEN 과 같은 값)
GAS_URL=https://script.google.com/macros/s/AKfycb.../exec
GAS_TOKEN=여기를-긴-비밀문자열로-바꾸세요

# 나
OWNER_NAME=홍길동
ADMIN_PIN=1234            # 웹페이지 로그인 + 봇에서 "관리자 1234"
TICK_KEY=아무-긴-문자열     # Apps Script 가 /api/tick 을 부를 때 쓰는 열쇠

# 네이버웍스 (선택 — 관리자 권한이 없으면 전부 비워 둔다. 웹페이지 '대화' 탭이 봇을 대신한다)
WORKS_CLIENT_ID=
WORKS_CLIENT_SECRET=
WORKS_SERVICE_ACCOUNT=xxxx.serviceaccount@도메인
WORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
WORKS_BOT_ID=
WORKS_BOT_SECRET=

# 메일플러그 — 메일 수집(IMAP) + 알림 발송(SMTP). 같은 계정을 쓴다. 비우면 둘 다 안 한다
MAIL_HOST=imap.mailplug.co.kr
MAIL_PORT=993
SMTP_HOST=smtp.mailplug.co.kr
SMTP_PORT=465
MAIL_USER=me@company.co.kr
MAIL_PASS=
OWNER_EMAIL=            # 브리핑을 다른 주소로 받고 싶을 때만. 비우면 MAIL_USER

# 시각 (한국시간, 24시간). 기본: 브리핑 8시, 팀원 리마인드 9시, 보고 요청 17시, 저녁 초안 18시. 평일만(1~5)
BRIEF_HOUR=8
REMIND_HOUR=9
ASK_HOUR=17
EVENING_HOUR=18
WORKDAYS=1,2,3,4,5

# ── AI 비서 (선택) — 둘 다 넣으면 가벼운 대화·명령은 Gemini, 분석·작성·긴 글은 Claude 로 자동 배분 ──
GEMINI_API_KEY=            # https://aistudio.google.com → Get API key
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=         # https://console.anthropic.com → API Keys (결제 등록 필요)
CLAUDE_MODEL=claude-opus-5
AI_BUDGET_KRW=10000        # 이 달 Claude 사용 추정액이 이 금액을 넘으면 그 달은 Gemini 만 쓴다
USD_KRW=1400

