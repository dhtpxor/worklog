# 서버 포트
PORT=8787
# 데이터 저장 폴더 (db.json + images/)
DATA_DIR=./data
# 촬영 링크에 쓸 공개 주소 (비우면 요청 Host 기준)
PUBLIC_BASE_URL=https://trueunit.example.com
# Claude 비전 분석. 비우면 AI 없이 전량 사람 검수
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# 업로드 한도 (바이트)
MAX_IMAGE_BYTES=8388608
MAX_BODY_BYTES=12582912
