PORT=8790
# 쇼핑몰 서버가 호출할 때 쓰는 키 (길고 무작위로). 비우면 API 가 모든 요청을 거절한다.
PRECHECK_API_KEY=
# Claude 분석 (이미지 속 로고, 다국어 분류, 사전에 없는 상표). 비우면 키워드 규칙만 쓴다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# 텍스트만으로 판매 불가가 나오면 AI 를 건너뛴다 (비용 절감)
AI_SKIP_WHEN_BLOCKED=true
# 수입식품등 인터넷 구매대행업 영업등록 여부
FOOD_AGENCY_REGISTERED=false
